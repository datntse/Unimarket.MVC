<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__links">
                    <a href="/"><i class="fa fa-home"></i> Trang chủ</a>
                    <span>Blog</span>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="contact spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="contact__map">
                    <img src="~/img/blog/Social2.png" alt="Alternate Text" width="600px" />
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="contact__content">
                    <div class="contact__address" style="margin-top:20px;">
                        <h5 style="font-weight:bold;">
                            Nguyên liệu chúng mình sử dụng là gì?
                        </h5>
                        <br />
                        <h6>
                            <i class="fa-solid" style="color: #FFD43B; height:20px;width:20px;"></i>
                            <strong>
                                Chất liệu của túi tái chế
                            </strong>
                        </h6>
                        <br />
                     
                        <ul>
                            <li>
                                <p>
                                    <i class="fa-solid" style="color: #74C0FC;"></i>
                                    Chất liệu chính để sản xuất túi đó là PP (Polypropylene) và PE (Polyethylene), hai loại nhựa phổ biến và dễ dàng tái chế. Đặc biệt, chúng mình tự hào khi áp dụng công nghệ tiên tiến mới, đó sử dụng chính các loại “rác thải nhựa thải ra môi trường” để tái chế và biến chúng thành những chiếc túi mà các bạn cầm trên tay. Quá trình này không chỉ giúp giảm thiểu số lượng lớn rác thải nhựa bên ngoài mà còn giúp tối ưu hóa việc tái sử dụng tài nguyên có sẵn.
                                </p>
                            </li>
                        </ul>
                        <br />


                        <h6>
                            <i class="fa-solid" style="color: #FFD43B; height:20px;width:20px;"></i>
                            <strong>
                                Lợi ích của việc sử dụng túi tái chế
                            </strong>
                        </h6>
                        <br />

                        <ul>
                            <li>
                                <p>
                                    <i class="fa-solid" style="color: #74C0FC;"></i>
                                    Việc sử dụng túi tái chế mang lại nhiều lợi ích cho môi trường và cộng đồng. Chúng giúp giảm lượng nhựa thải ra, giảm ô nhiễm đại dương và đất liền, đồng thời tiết kiệm tài nguyên thiên nhiên và giảm khí thải từ sản xuất nhựa mới. Túi tái chế bền, có thể sử dụng nhiều lần và phân hủy tự nhiên, giúp giảm chất thải nhựa. Ngoài ra, chúng còn nâng cao nhận thức cộng đồng về bảo vệ môi trường và khuyến khích thói quen tiêu dùng bền vững.
                                </p>
                            </li>
                        </ul>
                        <br />
                    </div>
                </div>
            </div>
           
           
        </div>
    </div>
</section>