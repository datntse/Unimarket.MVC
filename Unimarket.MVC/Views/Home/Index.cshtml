@model Unimarket.MVC.Models.ViewModels.ResponseProductVM1;

<section class="categories">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="col-lg-12 col-md-6 col-sm-6 p-0">
                        <div class="categories__item set-bg" data-setbg="img/banner/Thumb.png">
                            
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Categories Section End -->
<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4">
                <div class="section-title">
                    <h4>Sản phẩm mới</h4>
                </div>
            </div>
           
        </div>
        <div class="row property__gallery">
            @foreach (var item in Model.Data)
            {
                    <div class="col-lg-3 col-md-4 col-sm-6 mix quan">
                        <div class="product__item">
                            <div class="product__item__pic set-bg" data-setbg="@item.Images.First().imageUrl">
                                <ul class="product__hover">
                                <li><a href="@item.@item.Images.First().imageUrl" class="image-popup"><span class="arrow_expand"></span></a></li>
                                    <li><a asp-controller="ProductDetail" asp-action="Index" asp-route-id="@item.Id"><span class="icon_search"></span></a></li>
                                    <li>
                                        <form id="addToCartForm-@item.Id" asp-controller="Cart" asp-action="AddToCart" asp-route-itemId="@item.Id" method="post">
                                            <a href="#" onclick="submitAddToCartForm('@item.Id'); return false;">
                                                <span class="icon_bag_alt"></span>
                                            </a>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                            <div class="product__item__text">
                                <h6>@item.ProductName</h6>
                                <div class="rating">
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                </div>
                                <div class="product__price">@string.Format("{0:#,0}", item.Price)đ</div>
                            </div>

                        </div>
                    </div>
            }
            <div class="container">
                <div class="row justify-content-center">
                    <div class="seemore">
                        <a class="d-flex justify-content-center" href="@Url.Action("Index","Shop")">
                            Xem thêm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
